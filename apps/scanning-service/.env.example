PORT=4004
NODE_ENV=development
DATABASE_URL=postgresql://medusa:medusapassword@localhost:5432/medusa
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Python sidecar
PYTHON_BRIDGE_URL=http://localhost:8080
PYTHON_BRIDGE_PORT=8080
PYTHON_PATH=python3
PYTHON_SCRIPT_PATH=python/main.py
AUTO_START_PYTHON=true

# InsightFace model (buffalo_l = best, buffalo_s = faster/lighter)
INSIGHTFACE_MODEL=buffalo_l

# Object Storage (for downloading images to embed)
OBJECT_STORAGE_ENDPOINT=https://NAMESPACE.compat.objectstorage.us-ashburn-1.oraclecloud.com
OBJECT_STORAGE_BUCKET=medusa-files
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key
OBJECT_STORAGE_REGION=us-ashburn-1
