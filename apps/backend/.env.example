PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://medusa:medusapassword@localhost:5432/medusa

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# JWT
JWT_SECRET=change-me-to-a-random-256-bit-string
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Object Storage (Oracle Cloud S3-compatible)
OBJECT_STORAGE_ENDPOINT=https://NAMESPACE.compat.objectstorage.us-ashburn-1.oraclecloud.com
OBJECT_STORAGE_BUCKET=medusa-files
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key
OBJECT_STORAGE_REGION=us-ashburn-1

# Email (SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=notices@yourdomain.com
