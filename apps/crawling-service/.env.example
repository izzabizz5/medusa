PORT=4001
NODE_ENV=development
DATABASE_URL=postgresql://medusa:medusapassword@localhost:5432/medusa
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Object Storage
OBJECT_STORAGE_ENDPOINT=https://NAMESPACE.compat.objectstorage.us-ashburn-1.oraclecloud.com
OBJECT_STORAGE_BUCKET=medusa-files
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key
OBJECT_STORAGE_REGION=us-ashburn-1

# Proxy
PROXY_PROVIDER=none
# PROXY_PROVIDER=webshare
WEBSHARE_API_KEY=your-webshare-key
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
CRAWL_DELAY_MS=2000
CRAWL_CONCURRENCY=3

# FlareSolverr (optional, for Cloudflare-protected sites)
FLARESOLVERR_URL=http://localhost:8191
